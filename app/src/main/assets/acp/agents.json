{
  "version": 1,
  "retiredAgentIds": ["gemini-cli-acp", "deepseek-harness-acp"],
  "agents": [
    {
      "id": "xiaowan-acp",
      "name": "小万",
      "nameEn": "Omnibot",
      "description": "小万内置能力通过官方 ACP Agent 接口提供",
      "descriptionEn": "Omnibot's built-in capabilities through the official ACP Agent interface",
      "command": "omnibot-xiaowan-acp",
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "omnibot-xiaowan-acp",
        "usesSharedProvider": true,
        "embedded": true
      }
    },
    {
      "id": "na-cloud",
      "name": "Na",
      "nameEn": "Na",
      "description": "云端个人助手 · 独立模型、长期记忆与任务",
      "descriptionEn": "Cloud personal assistant with its own models, long-term memory, and tasks",
      "command": "na-cloud",
      "arguments": [],
      "enabled": true,
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "na-cloud",
        "embedded": true,
        "usesSharedProvider": false,
        "declaredCapabilities": {
          "cloudModelManaged": true,
          "transport": "http"
        }
      }
    },
    {
      "id": "claude-code-acp",
      "name": "Claude Code",
      "description": "Claude Code through the ACP adapter",
      "command": "claude-agent-acp",
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "claude",
        "managedAdapterPackage": "@anthropic-ai/claude-code@latest",
        "managedAdapterPackages": [
          "@anthropic-ai/claude-code@latest",
          "@agentclientprotocol/claude-agent-acp@0.74.0"
        ],
        "configAdapterId": "claude-code",
        "usesSharedProvider": true,
        "terminalPackageId": "claude_code",
        "managedUninstallStrategy": "claude-code",
        "preparationRevision": "claude-agent-acp-0.74.0"
      }
    },
    {
      "id": "codex-acp",
      "name": "Codex",
      "description": "OpenAI Codex through its managed ACP adapter",
      "command": "codex-acp",
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "codex",
        "managedAdapterPackage": "@openai/codex@latest",
        "managedAdapterPackages": [
          "@openai/codex@latest",
          "@agentclientprotocol/codex-acp@1.10.0"
        ],
        "configAdapterId": "codex",
        "usesSharedProvider": true,
        "terminalPackageId": "codex",
        "managedUninstallStrategy": "codex",
        "managedInstallCommandAsset": "acp/install-codex.sh",
        "preparationRevision": "codex-acp-1.10.0-message-completion-1-title-model-1"
      }
    },
    {
      "id": "opencode-acp",
      "name": "OpenCode",
      "description": "OpenCode ACP server",
      "command": "opencode",
      "arguments": ["acp"],
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "opencode",
        "managedAdapterPackage": "@opencode/cli@latest",
        "managedAdapterPackages": ["@opencode/cli@latest"],
        "configAdapterId": "open-code",
        "usesSharedProvider": true,
        "terminalPackageId": "opencode",
        "managedUninstallStrategy": "opencode",
        "managedInstallCommandAsset": "acp/install/opencode.sh",
        "managedAdapterHealthCommand": "node -e \"const expected = require('/root/.npm-global/lib/node_modules/@opencode/cli/package.json').version; const actual = require('node:child_process').execFileSync('opencode', ['--version'], {timeout:8000,encoding:'utf8'}).trim().replace(/^opencode v/, ''); if (Number(expected.split('.')[0]) < 2 || actual !== expected) process.exit(1)\"",
        "validateBeforeConfigWrite": true,
        "preparationRevision": "opencode-cli-v2-rootfs-libc-v1"
      }
    },
    {
      "id": "pi-acp",
      "name": "Pi",
      "description": "Pi official SDK through the OmniBot ACP adapter",
      "command": "omnibot-pi-acp",
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "omnibot-pi-acp",
        "managedAdapterPackages": ["@earendil-works/pi-coding-agent@1.4.0"],
        "configAdapterId": "pi",
        "usesSharedProvider": true,
        "terminalPackageId": "pi",
        "managedUninstallStrategy": "pi",
        "managedInstallScriptPath": "/root/.local/share/omnibot/install-pi-acp.sh",
        "managedInstallCommandAsset": "acp/install/pi.sh",
        "managedAdapterHealthCommand": "PATH=/root/.npm-global/bin:$PATH; export PATH; omnibot-pi-acp --health",
        "preparationRevision": "pi-1.4.0-4a48f6d36fbd1811e5ac"
      }
    },
    {
      "id": "kimi-code-acp",
      "name": "Kimi Code",
      "description": "Kimi Code through its official ACP interface",
      "command": "kimi",
      "arguments": ["acp"],
      "builtIn": true,
      "runtime": {
        "discoveryCommand": "kimi",
        "managedAdapterPackage": "@moonshot-ai/kimi-code@latest",
        "managedAdapterPackages": ["@moonshot-ai/kimi-code@latest"],
        "managedAdapterHealthCommand": "export PATH=/root/.npm-global/bin:$PATH; command -v kimi >/dev/null 2>&1 && node -e 'const [major, minor] = process.versions.node.split(\".\").map(Number); if (major < 22 || (major === 22 && minor < 19)) process.exit(1)'",
        "configAdapterId": "kimi-code",
        "usesSharedProvider": true,
        "terminalPackageId": "kimi",
        "managedUninstallStrategy": "kimi-code",
        "managedInstallCommand": "npm install -g --no-audit --no-fund --prefix /root/.npm-global --registry=https://registry.npmmirror.com @moonshot-ai/kimi-code@latest || npm install -g --no-audit --no-fund --prefix /root/.npm-global @moonshot-ai/kimi-code@latest",
        "preparationRevision": "kimi-code-acp-v1"
      }
    }
  ]
}
