<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OmnibotApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Manifest themes follow the current night configuration. The explicit
         light/dark themes also support the saved in-app theme at handoff. -->
    <style name="Theme.OmnibotApp.Splash" parent="Theme.OmnibotApp.Splash.Light" />
    <style name="Theme.OmnibotApp.Splash.Dot" parent="Theme.OmnibotApp.Splash.Dot.Light" />
    <style name="Theme.OmnibotApp.Splash.Cursor" parent="Theme.OmnibotApp.Splash.Cursor.Light" />
    <style name="Theme.OmnibotApp.Splash.Wave" parent="Theme.OmnibotApp.Splash.Wave.Light" />
    <style name="Theme.OmnibotApp.Splash.Open" parent="Theme.OmnibotApp.Splash.Open.Light" />
    <style name="Theme.OmnibotApp.Splash.Classic" parent="Theme.OmnibotApp.Splash.Classic.Light" />

    <style name="Theme.OmnibotApp.Splash.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#F4F7FB</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
        <item name="android:statusBarColor">#151617</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Dot.Light" parent="Theme.OmnibotApp.Splash.Light">
        <item name="android:windowBackground">@drawable/splash_background_dot</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Dot.Dark" parent="Theme.OmnibotApp.Splash.Dark">
        <item name="android:windowBackground">@drawable/splash_background_dot_dark</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Cursor.Light" parent="Theme.OmnibotApp.Splash.Light">
        <item name="android:windowBackground">@drawable/splash_background_cursor</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Cursor.Dark" parent="Theme.OmnibotApp.Splash.Dark">
        <item name="android:windowBackground">@drawable/splash_background_cursor_dark</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Wave.Light" parent="Theme.OmnibotApp.Splash.Light">
        <item name="android:windowBackground">@drawable/splash_background_wave</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Wave.Dark" parent="Theme.OmnibotApp.Splash.Dark">
        <item name="android:windowBackground">@drawable/splash_background_wave_dark</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Open.Light" parent="Theme.OmnibotApp.Splash.Light">
        <item name="android:windowBackground">@drawable/splash_background_open</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Open.Dark" parent="Theme.OmnibotApp.Splash.Dark">
        <item name="android:windowBackground">@drawable/splash_background_open_dark</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Classic.Light" parent="Theme.OmnibotApp.Splash.Light">
        <item name="android:windowBackground">@drawable/splash_background_classic</item>
    </style>

    <style name="Theme.OmnibotApp.Splash.Classic.Dark" parent="Theme.OmnibotApp.Splash.Dark">
        <item name="android:windowBackground">@drawable/splash_background_classic_dark</item>
    </style>

    <!-- 一键登录Activity主题：禁用返回手势 -->
    <style name="Theme.OmnibotApp.LoginAuth" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 覆盖SDK的authsdk_activity_dialog主题，使用AppCompat兼容主题 -->
    <style name="authsdk_activity_dialog" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <!-- 移除 windowIsFloating，让 Activity 可以控制状态栏 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>  <!-- 允许绘制状态栏 -->
        <item name="android:statusBarColor">@android:color/white</item>   <!-- API 21+ -->
        <item name="android:windowLightStatusBar">true</item>             <!-- API 23+ 浅色状态栏图标 -->
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 完全透明的Activity主题，用于剪贴板等需要前台焦点的操作 -->
    <style name="Theme.OmnibotApp.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 底部半屏弹窗主题 -->
    <style name="Theme.OmnibotApp.BottomSheet">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
    </style>

    <!-- 底部半屏弹窗动画 -->
    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

</resources>
