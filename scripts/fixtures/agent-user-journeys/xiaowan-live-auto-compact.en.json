      "action": "checkpoint",
      "marker": "OOB_LIVE_AUTO_COMPACT"
    },
    {
      "action": "restart"
    },
    {
      "action": "reply",
      "text": "OOB_LIVE_AUTO_COMPACT_DONE"
    },
    {
      "action": "checkpoint",
      "marker": "OOB_LIVE_AUTO_COMPACT"
    },
    {
      "action": "live-task",
      "marker": "OOB_LIVE_AUTO_COMPACT",
      "phase": "auto-pages"
    }
