{
  "name": "Preserve draft across Kimi Code and Xiaowan selection, then send once",
  "requireClockSync": true,
  "steps": [
    {
      "action": "prepare-draft",
      "marker": "OOB_LIVE_SWITCH_DRAFT",
      "scenario": "xiaowan-switch-reply.json",
      "timeoutMs": 180000
    },
    {
      "action": "tap",
      "label": "Switch Agent mode"
    },
    {
      "action": "tap",
      "label": "Kimi Code"
    },
    {
      "action": "assert-draft",
      "marker": "OOB_LIVE_SWITCH_DRAFT",
      "scenario": "xiaowan-switch-reply.json",
      "agentId": "kimi-code-acp",
      "agentLabel": "Kimi Code"
    },
    {
      "action": "tap",
      "label": "Switch Agent mode"
    },
    {
      "action": "tap",
      "label": "小万"
    },
    {
      "action": "assert-draft",
      "marker": "OOB_LIVE_SWITCH_DRAFT",
      "scenario": "xiaowan-switch-reply.json",
      "agentId": "xiaowan-acp",
      "agentLabel": "小万"
    },
    {
      "action": "tap",
      "label": "Send"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_LIVE_SWITCH_DRAFT",
      "expected": "done",
      "agentId": "xiaowan-acp",
      "timeoutMs": 180000
    },
    {
      "action": "restart"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_LIVE_SWITCH_DRAFT",
      "expected": "done",
      "agentId": "xiaowan-acp"
    }
  ]
}
