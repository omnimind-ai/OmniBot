{
  "name": "Structured ACP provider errors and next request survive restart",
  "steps": [
    {
      "action": "send",
      "marker": "OOB_FAILURE_STREAMAUTH"
    },
    {
      "action": "expect",
      "text": "Failed",
      "timeoutMs": 45000
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMAUTH",
      "expected": "error",
      "summary": "模型连接验证失败，请在模型设置中检查接口地址和密钥。"
    },
    {
      "action": "send",
      "marker": "OOB_FAILURE_STREAMSERVICE"
    },
    {
      "action": "expect",
      "text": "Failed",
      "timeoutMs": 45000
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMSERVICE",
      "expected": "error",
      "summary": "模型服务商暂时不可用，请稍后再试或更换模型连接。"
    },
    {
      "action": "send",
      "marker": "OOB_FAILURE_STREAMREJECT"
    },
    {
      "action": "expect",
      "text": "Failed",
      "timeoutMs": 45000
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMREJECT",
      "expected": "error",
      "summary": "模型服务商拒绝了本次请求，请检查模型及请求配置。"
    },
    {
      "action": "send",
      "marker": "OOB_FAILURE_STREAMMODEL"
    },
    {
      "action": "expect",
      "text": "Failed",
      "timeoutMs": 45000
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMMODEL",
      "expected": "error",
      "summary": "当前模型不可用，请在模型设置中重新选择。"
    },
    {
      "action": "send",
      "marker": "OOB_FAILURE_OK"
    },
    {
      "action": "reply",
      "text": "OOB_FAILURE_OK_DONE"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_OK",
      "expected": "done"
    },
    {
      "action": "restart"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMAUTH",
      "expected": "error",
      "summary": "模型连接验证失败，请在模型设置中检查接口地址和密钥。"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMSERVICE",
      "expected": "error",
      "summary": "模型服务商暂时不可用，请稍后再试或更换模型连接。"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMREJECT",
      "expected": "error",
      "summary": "模型服务商拒绝了本次请求，请检查模型及请求配置。"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_STREAMMODEL",
      "expected": "error",
      "summary": "当前模型不可用，请在模型设置中重新选择。"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_OK",
      "expected": "done"
    }
  ]
}
