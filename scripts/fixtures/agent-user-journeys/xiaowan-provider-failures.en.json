{
  "name": "Provider failures remain terminal and allow a new user turn",
  "steps": [
    {
      "action": "send",
      "marker": "OOB_FAILURE_AUTH"
    },
    {
      "action": "expect",
      "text": "Failed",
      "timeoutMs": 60000
    },
    {
      "action": "expect",
      "text": "Send"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FAILURE_AUTH",
      "expected": "error"
    },
    {
      "action": "send",
      "marker": "OOB_FILE_TEXT_AFTERAUTH"
    },
    {
      "action": "reply",
      "text": "OOB_FILE_TEXT_AFTERAUTH_DONE"
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_FILE_TEXT_AFTERAUTH",
      "expected": "done"
    },
